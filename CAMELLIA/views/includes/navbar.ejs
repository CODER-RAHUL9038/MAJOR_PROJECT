<nav class="navbar navbar-expand-md">
  <div class="container-fluid px-md-5">
    <a class="navbar-brand" href="/listings">
      <img class="nav-logo" src="/images/shortlogo.png" alt="Camellia Logo" />
    </a>

    <!-- MOBILE ACTIONS (AVATAR + TOGGLER) -->
    <div class="d-flex d-md-none align-items-center gap-3">
      <% if (currUser) { %>
        <%- include("./navbar_avatar.ejs") %>
      <% } %>
      <button
        class="navbar-toggler border-0 shadow-none p-0"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNavAltMarkup"
        aria-controls="navbarNavAltMarkup"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <i class="fa-solid fa-bars fs-4"></i>
      </button>
    </div>

    
    <!-- PREMIUM SEARCH BAR (CENTERED ON DESKTOP) -->
    <div class="search-container d-none d-md-block">
      <form class="search-form" role="search" method="get" action="/listings">
        <input
          name="search"
          class="search-input-premium"
          type="search"
          placeholder="Start your search"
          aria-label="Search"
        />
        
        <button class="search-btn-premium" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
    </div>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav ms-auto align-items-md-center gap-2">
        <a class="nav-link premium-nav-link" href="/listings/new">Airbnb your home</a>
        
        <% if (!currUser) { %>
          <a class="nav-link premium-nav-link" href="/SignUp"><b>Sign up</b></a>
          <a class="nav-link premium-nav-link" href="/login"><b>Login</b></a>
        <% } else { %>
          <div class="d-none d-md-block">
            <%- include("./navbar_avatar.ejs") %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- MOBILE SEARCH BAR - BELOW TOP NAV -->
  <div class="d-md-none px-3 pb-2 w-100 mt-2">
    <form class="search-form-mobile" role="search" method="get" action="/listings">
      <div class="search-input-wrapper-mobile">
        <i class="fa-solid fa-magnifying-glass search-icon-mobile"></i>
        <input
          name="search"
          class="form-control rounded-pill search-input-mobile"
          type="search"
          placeholder="Where to?"
          aria-label="Search"
        />
      </div>
    </form>
  </div>
</nav>
