          <div class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
              <div class="user-avatar-container">
                <% 
                  // ULTRA-ROBUST AVATAR RESOLUTION
                  const fallback = "https://res.cloudinary.com/dmue96vxb/image/upload/v1703612502/default_avatar_p3f2zv.png";
                  let src = fallback;
                  
                  if (currUser) {
                    if (currUser.avatar) {
                      if (typeof currUser.avatar === 'string' && currUser.avatar.length > 5) {
                        src = currUser.avatar;
                      } else if (currUser.avatar.url && typeof currUser.avatar.url === 'string' && currUser.avatar.url.length > 5) {
                        src = currUser.avatar.url;
                      }
                    }
                  }
                %>
                <img src="<%= src %>" 
                     alt="Profile" 
                     class="user-nav-avatar" 
                     onerror="this.onerror=null;this.src='https://res.cloudinary.com/dmue96vxb/image/upload/v1703612502/default_avatar_p3f2zv.png';">
              </div>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 p-2 rounded-4">
              <li class="px-3 py-2 border-bottom mb-2">
                <span class="d-block fw-bold small text-truncate" style="max-width: 150px;"><%= currUser.username %></span>
                <span class="d-block text-secondary smaller text-truncate" style="max-width: 150px; font-size: 0.75rem;"><%= currUser.email %></span>
              </li>
              <li><a class="dropdown-item rounded-3" href="/logout">Logout</a></li>
            </ul>
          </div>
