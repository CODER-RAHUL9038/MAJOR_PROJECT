<!-- MODERN TOAST FLASH SYSTEM -->
<!-- Data bridge for toast.js to pick up -->
<script id="flash-data-script">
    window.flashMessages = {
        success: <%- JSON.stringify(typeof success !== "undefined" ? success : []) %>,
        error: <%- JSON.stringify(typeof error !== "undefined" ? error : []) %>,
        warning: <%- JSON.stringify(typeof warning !== "undefined" ? warning : []) %>,
        info: <%- JSON.stringify(typeof info !== "undefined" ? info : []) %>
    };
</script>

<!-- Toast container will be dynamically injected by toast.js if not present -->
<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>
