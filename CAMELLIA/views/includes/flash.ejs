<!-- MODERN TOAST FLASH SYSTEM -->
<!-- Hidden data container for toast.js to pick up -->
<div id="flash-data" 
    data-success='<%- JSON.stringify(typeof success !== "undefined" ? success : []) %>'
    data-error='<%- JSON.stringify(typeof error !== "undefined" ? error : []) %>'
    data-warning='<%- JSON.stringify(typeof warning !== "undefined" ? warning : []) %>'
    data-info='<%- JSON.stringify(typeof info !== "undefined" ? info : []) %>'
    style="display: none;">
</div>

<!-- Toast container will be dynamically injected by toast.js if not present -->
<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>
