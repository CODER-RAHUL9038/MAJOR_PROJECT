<% layout("/layouts/boilerplate") -%>

<div class="filters-wrapper">
  <div class="container-fluid px-md-5">
    <div class="d-flex align-items-center">
      <!-- LEFT ARROW -->
      <button class="btn arrow-btn d-none d-md-flex me-3" id="scrollLeft">
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <!-- Filters -->
      <div id="filters" class="flex-grow-1">
        <% 
          const categories = [
            { id: 'trending', label: 'Trending', icon: 'fa-fire' },
            { id: 'rooms', label: 'Rooms', icon: 'fa-bed' },
            { id: 'city', label: 'Cities', icon: 'fa-city' },
            { id: 'mountain', label: 'Mountain', icon: 'fa-mountain' },
            { id: 'castle', label: 'Castles', icon: 'fa-fort-awesome', brand: true },
            { id: 'pool', label: 'Pools', icon: 'fa-person-swimming' },
            { id: 'camping', label: 'Camping', icon: 'fa-campground' },
            { id: 'farm', label: 'Farms', icon: 'fa-tractor' },
            { id: 'arctic', label: 'Arctic', icon: 'fa-snowman' },
            { id: 'forest', label: 'Forest', icon: 'fa-tree' },
            { id: 'beach', label: 'Beach', icon: 'fa-umbrella-beach' },
            { id: 'heritage', label: 'Heritage', icon: 'fa-synagogue' }
          ];
        %>
        <% for(let cat of categories) { %>
          <a href="/listings?category=<%= cat.id %>" class="text-decoration-none">
            <div class="filter <%= category === cat.id ? 'active' : '' %>">
              <i class="<%= cat.brand ? 'fa-brands' : 'fa-solid' %> <%= cat.icon %>"></i>
              <p><%= cat.label %></p>
            </div>
          </a>
        <% } %>
      </div>

      <!-- RIGHT ARROW -->
      <button class="btn arrow-btn d-none d-md-flex ms-3" id="scrollRight">
        <i class="fa-solid fa-chevron-right"></i>
      </button>

      <!-- TAXES TOGGLE -->
      <div class="tax-toggle d-none d-lg-flex align-items-center ms-4 p-3 border rounded-3 bg-white shadow-sm" style="height: 48px; cursor: pointer;">
        <div class="form-check form-switch p-0 m-0 d-flex align-items-center gap-2">
          <label class="form-check-label fs-small fw-bold" for="flexSwitchCheckDefault" style="font-size: 0.75rem; white-space: nowrap; cursor: pointer;">Display total before taxes</label>
          <input class="form-check-input m-0" style="cursor: pointer;" type="checkbox" role="switch" id="flexSwitchCheckDefault">
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ERROR MESSAGE FOR SEARCH  -->
<div class="row justify-content-center">
  <div class="col col-10 col-md-8">
    <% if (!hasResults) { %>
    <div class="alert alert-info text-center mt-4">
      No results found <% if (search) { %> for "<strong><%= search %></strong>"
      <% } %>
    </div>
    <!-- ERROR CLEAR FILTER -->
    <div class="text-center">
      <a href="/listings" class="btn btn-outline-secondary mt-2">
        Clear filters
      </a>
    </div>
    <% } %>
  </div>
</div>

<div class="container-fluid px-md-5">
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    <% for(let listing of listings) { %>
    <div class="col">
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card listing-card h-100">
          <div class="card-img-container">
            <img
              loading="lazy"
              src="<%= listing.image.url + '?w=600&auto=format&fit=crop&q=60' %>"
              class="card-img-top"
              alt="listing-image"
            />
          </div>
          <div class="card-body">
            <h5 class="card-title-premium"><%= listing.title %></h5>
            <p class="card-location-premium"><%= listing.location %>, <%= listing.country %></p>
            <p class="card-price-premium">
              &#8377;<%= listing.price.toLocaleString("en-IN") %> <span>night</span>
            </p>
          </div>
        </div>
      </a>
    </div>
    <% } %>
  </div>
</div>

<!-- PAGINATION PREMIUM -->
<div class="container-fluid px-md-5 pagination-container">
  <div class="d-flex justify-content-center align-items-center gap-3">
    <% if (currentPage > 1) { %>
    <a href="/listings?page=<%= currentPage - 1 %>" class="btn btn-outline-dark btn-pagination">
      <i class="fa-solid fa-chevron-left me-2"></i> Prev
    </a>
    <% } %>

    <div class="d-flex gap-2">
      <% for (let i = 1; i <= totalPages; i++) { %>
      <a
        href="/listings?page=<%= i %><%= category ? `&category=${category}` : '' %><%= search ? `&search=${search}` : '' %>"
        class="btn <%= currentPage === i ? 'btn-dark' : 'btn-outline-dark' %> rounded-circle d-flex align-items-center justify-content-center"
        style="width: 40px; height: 40px;"
      >
        <%= i %>
      </a>
      <% } %>
    </div>

    <% if (currentPage < totalPages) { %>
    <a href="/listings?page=<%= currentPage + 1 %>" class="btn btn-outline-dark btn-pagination">
      Next <i class="fa-solid fa-chevron-right ms-2"></i>
    </a>
    <% } %>
  </div>
</div>
<script src="/js/index.js"></script>
