<% layout("/layouts/boilerplate") -%>

<!-- ERROR MESSAGE FOR SEARCH  -->
<div class="row justify-content-center">
  <div class="col col-10 col-md-8">
    <% if (!hasResults) { %>
    <div class="premium-inline-alert text-center mt-4">
      <i class="fa-solid fa-magnifying-glass"></i>
      <div>
        No results found <% if (search) { %> for "<strong><%= search %></strong>"
        <% } %>
      </div>
    </div>
    <!-- ERROR CLEAR FILTER -->
    <div class="text-center">
      <a href="/listings" class="btn btn-outline-secondary mt-3 rounded-pill px-4">
        Clear filters
      </a>
    </div>
    <% } %>
  </div>
</div>

<div class="container-fluid px-md-5">
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    <% for(let listing of listings) { %>
    <div class="col">
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card listing-card h-100">
          <div class="card-img-container">
            <img
              loading="lazy"
              src="<%= listing.image.url + '?w=600&auto=format&fit=crop&q=60' %>"
              class="card-img-top"
              alt="listing-image"
            />
          </div>
          <div class="card-body">
            <h5 class="card-title-premium"><%= listing.title %></h5>
            <p class="card-location-premium"><%= listing.location %>, <%= listing.country %></p>
            <p class="card-price-premium">
              <span class="price-container">
                &#8377;<span class="price-value" data-base-price="<%= listing.price %>"><%= listing.price.toLocaleString("en-IN") %></span> <span>night</span>
              </span>
              <i class="tax-info text-primary ms-2" style="display: none; font-style: normal; font-size: 0.85rem; font-weight: 700;">&nbsp; + 18% GST</i>
            </p>
          </div>
        </div>
      </a>
    </div>
    <% } %>
  </div>
</div>

<!-- PAGINATION PREMIUM -->
<% if (totalPages > 1) { %>
<div class="container-fluid px-md-5 pagination-container">
  <div class="d-flex justify-content-center align-items-center gap-3">
    <% if (currentPage > 1) { %>
    <a href="/listings?page=<%= currentPage - 1 %>" class="btn btn-outline-dark btn-pagination rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;" aria-label="Previous Page">
      <i class="fa-solid fa-chevron-left"></i>
    </a>
    <% } %>

    <div class="d-flex gap-2">
      <% for (let i = 1; i <= totalPages; i++) { %>
      <a
        href="/listings?page=<%= i %><%= category ? `&category=${category}` : '' %><%= search ? `&search=${search}` : '' %>"
        class="btn <%= currentPage === i ? 'btn-dark' : 'btn-outline-dark' %> rounded-circle d-flex align-items-center justify-content-center"
        style="width: 40px; height: 40px;"
      >
        <%= i %>
      </a>
      <% } %>
    </div>

    <% if (currentPage < totalPages) { %>
    <a href="/listings?page=<%= currentPage + 1 %>" class="btn btn-outline-dark btn-pagination rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;" aria-label="Next Page">
      <i class="fa-solid fa-chevron-right"></i>
    </a>
    <% } %>
  </div>
</div>
<% } %>
<script src="/js/index.js"></script>
