<% layout("/layouts/boilerplate") -%>

<div class="container-fluid px-md-5 mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9">
      <div class="d-flex align-items-center mb-4 gap-3">
        <a href="/listings" class="btn btn-outline-dark btn-sm rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;" title="Go Back">
          <i class="fa-solid fa-chevron-left"></i>
        </a>
        <h2 class="premium-heading mb-0"><%= listing.title %></h2>
      </div>
      
      <div class="show-img-container">
        <img
          src="<%= listing.image.url + '?w=1200&auto=format&fit=crop&q=80' %>"
          class="show-img"
          alt="listing_image"
        />
      </div>

      <div class="row mt-4 g-4">
        <!-- DETAILS LEFT SIDE -->
        <div class="col-12 col-md-8">
          <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
            <div>
              <h4 class="fw-bold mb-1">Hosted by <%= listing.owner ? listing.owner.username : "Unknown Host" %></h4>
              <p class="text-secondary mb-0">Member since 2025</p>
            </div>
            <div class="user-avatar-container">
                <% 
                  // CLEAN AVATAR RESOLUTION
                  let currentAvatar = "https://lh3.googleusercontent.com/a/default-user=s100-c";
                  
                  if (currUser && currUser.avatar) {
                    if (currUser.avatar.url) {
                      currentAvatar = currUser.avatar.url;
                    } else if (typeof currUser.avatar === 'string' && currUser.avatar.length > 5) {
                      currentAvatar = currUser.avatar;
                    }
                  }
                %>
                <img src="<%= currentAvatar %>" 
                     alt="Profile" 
                     class="user-nav-avatar" 
                     referrerpolicy="no-referrer"
                     crossorigin="anonymous"
                     onerror="this.onerror=null;this.src='https://lh3.googleusercontent.com/a/default-user=s100-c';">
              </div>
          </div>

          <div class="listing-detail-container">
            <div class="detail-icon-box">
              <i class="fa-solid fa-circle-info"></i>
              <div>
                <p class="detail-label mb-0">About this place</p>
                <p class="detail-text"><%= listing.description %></p>
              </div>
            </div>

            <div class="detail-icon-box">
              <i class="fa-solid fa-location-dot"></i>
              <div>
                <p class="detail-label mb-0">Location</p>
                <p class="detail-text"><%= listing.location %>, <%= listing.country %></p>
              </div>
            </div>

            <div class="detail-icon-box">
              <i class="fa-solid fa-layer-group"></i>
              <div>
                <p class="detail-label mb-0">Category</p>
                <p class="detail-text" style="text-transform: capitalize;"><%= listing.category %></p>
              </div>
            </div>
          </div>

          <% if (listing.owner && currUser && currUser._id.equals(listing.owner._id)) { %>
          <div class="show-btns d-flex gap-3 mt-2 pt-2 ">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger px-4 rounded-pill">Edit</a>
            <form
              data-btn-text="Deleting..."
              method="post"
              action="/listings/<%= listing._id %>?_method=DELETE"
              onsubmit="disableBtn(this)"
            >
              <button class="btn btn-dark px-4 rounded-pill">Delete</button>
            </form>
          </div>
          <% } %>
        </div>

        
      </div>

      <!-- Review Section -->
      <div class="mt-5 pt-5 border-top">
        <% if (currUser) { %>
        <h4 class="fw-bold mb-4">Leave a Review</h4>
        <form
          data-btn-text="Adding"
          class="mb-5 needs-validation"
          novalidate
          method="post"
          action="/listings/<%= listing._id %>/reviews"
          onsubmit="disableBtn(this)"
        >
          <div class="mb-4">
            <fieldset class="starability-grow">
              <legend class="fs-6 fw-bold">Rating</legend>
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold" for="comment">Comment</label>
            <textarea
              required
              class="form-control rounded-4 p-3 shadow-sm"
              name="review[comment]"
              id="comment"
              cols="30"
              rows="4"
              placeholder="Share your experience..."
            ></textarea>
            <div class="invalid-feedback">Please write a short review!</div>
          </div>
          <button class="btn btn-dark px-5 py-2 rounded-pill">Submit Review</button>
        </form>
        <% } %>

        <% if (listing.reviews && listing.reviews.length > 0) { %>
        <h4 class="fw-bold mb-4">All Reviews</h4>
        <div class="row row-cols-1 row-cols-md-2 g-4">
          <% for( let review of listing.reviews ) { %>
          <div class="col">
            <div class="card review-card h-100">
              <div class="card-body p-0">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <i class="fa-solid fa-circle-user fs-2 text-secondary"></i>
                    <div>
                        <h5 class="mb-0">@<%= review.author ? review.author.username : "Anonymous" %></h5>
                        <p class="text-secondary small mb-0">October 2025</p>
                    </div>
                </div>
                <p
                  class="starability-result mb-3"
                  data-rating="<%= review.rating %>"
                ></p>
                <p class="card-text"><%= review.comment %></p>
              </div>

              <% if (review.author && currUser && review.author._id.equals(currUser._id)) { %>
              <form
                data-btn-text="Deleting"
                method="post"
                class="mt-3"
                onsubmit="disableBtn(this)"
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
              >
                <button class="btn btn-sm btn-outline-danger px-3 rounded-pill">Delete</button>
              </form>
              <% } %>
            </div>
          </div>
          <% } %>
        </div>
        <% } %>
      </div>

      <div class="mt-5 pt-5 border-top">
        <h4 class="fw-bold mb-4">Where you’ll be</h4>
        <div id="map" style="height: 480px; width: 100%;"></div>
      </div>
    </div>
  </div>
</div>

<!-- 2️⃣ Inject backend data into JS -->
<script>

    const MAPTILER_KEY = "<%= process.env.MAPTILER_KEY %>";
  //Ignore syntax error. Since js don't understand ejs syntax
    const coords = <%- JSON.stringify(listing.geometry.coordinates) %>;


  // For disabling button after submitting
  function  disableBtn(form){
    const btn  = form.querySelector("button")
   const text = form.dataset.btnText || "Processing...";

    btn.disabled = true
    btn.innerText = text
  }
</script>
<script src="/js/map.js"></script>
