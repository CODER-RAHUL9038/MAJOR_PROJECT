<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center mt-4">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="card shadow-lg border-0 p-4 p-md-5 rounded-4">
      <h2 class="premium-heading mb-4">Airbnb your home</h2>
      
      <form
        method="post"
        action="/listings"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data"
        onsubmit="handleSubmit(event,this)"
      >
        <div class="mb-4">
          <label for="title" class="form-label fw-bold">Title</label>
          <input
            class="form-control rounded-3 py-2 px-3 border-secondary-subtle shadow-sm"
            type="text"
            name="listing[title]"
            id="title"
            placeholder="Give your place a catchy title"
            maxlength="50"
            required
          />
          <div class="invalid-feedback">Please provide a title!</div>
        </div>

        <div class="mb-4">
          <label for="description" class="form-label fw-bold">Description</label>
          <textarea
            required
            class="form-control rounded-3 py-2 px-3 border-secondary-subtle shadow-sm"
            name="listing[description]"
            placeholder="Tell guests what makes your place special"
            id="description"
            rows="5"
          ></textarea>
          <div class="invalid-feedback">Please provide a description!</div>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label for="price" class="form-label fw-bold">Price per night</label>
            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                <span class="input-group-text border-secondary-subtle bg-light">&#8377;</span>
                <input
                  type="number"
                  class="form-control border-secondary-subtle border-start-0 py-2"
                  name="listing[price]"
                  id="price"
                  placeholder="1200"
                  required
                />
            </div>
            <div class="invalid-feedback">Please enter a valid price!</div>
          </div>
          <div class="col-md-8">
            <label for="country" class="form-label fw-bold">Country</label>
            <input
              required
              class="form-control rounded-3 py-2 px-3 border-secondary-subtle shadow-sm"
              type="text"
              name="listing[country]"
              id="country"
              placeholder="e.g. India"
            />
            <div class="invalid-feedback">Please enter the country!</div>
          </div>
        </div>

        <div class="mb-4">
          <label for="image" class="form-label fw-bold">Cover Image</label>
          <input
            type="file"
            class="form-control rounded-3 py-2 px-3 border-secondary-subtle shadow-sm"
            name="listing[image]"
            id="image"
            required
          />
          <div class="invalid-feedback">Please upload an image!</div>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label for="location" class="form-label fw-bold">Location</label>
            <input
              required
              class="form-control rounded-3 py-2 px-3 border-secondary-subtle shadow-sm"
              type="text"
              name="listing[location]"
              id="location"
              placeholder="e.g. Kolkata, West Bengal"
            />
            <div class="invalid-feedback">Please provide a location!</div>
          </div>
          <div class="col-md-6">
            <label for="select" class="form-label fw-bold">Category</label>
            <select
              class="form-select rounded-3 py-2 px-3 border-secondary-subtle shadow-sm"
              id="select"
              required
              name="listing[category]"
            >
              <option value="" disabled selected>Select Category</option>
              <option value="trending">Trending</option>
              <option value="rooms">Rooms</option>
              <option value="city">City</option>
              <option value="mountain">Mountain</option>
              <option value="castle">Castle</option>
              <option value="pool">Pool</option>
              <option value="camping">Camping</option>
              <option value="farm">Farm</option>
              <option value="arctic">Arctic</option>
              <option value="forest">Forest</option>
              <option value="beach">Beach</option>
              <option value="heritage">Heritage</option>
            </select>
            <div class="invalid-feedback">Please select a category!</div>
          </div>
        </div>

        <button class="btn btn-dark w-100 py-3 rounded-3 fw-bold shadow-sm" data-btn-text="Listing your home...">
          Create Listing
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  function handleSubmit(e, form) {
    if (!form.checkValidity()) {
      return; 
    }
    const btn = form.querySelector("button");
    const text = btn.dataset.btnText;
    btn.disabled = true;
    btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> ${text}`;
  }
</script>
