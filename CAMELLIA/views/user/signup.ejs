<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center mt-5">
  <div class="col-12 col-md-6 col-lg-5">
    <div class="card shadow-lg border-0 p-4 rounded-4">
      <h2 class="premium-heading text-center mb-4">Create Account</h2>
      
      <form method="post" action="/signup" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="username" class="form-label fw-bold">Username</label>
          <input
            class="form-control rounded-pill px-3 py-2 border-secondary-subtle shadow-sm"
            type="text"
            name="username"
            required
            id="username"
            placeholder="Choose a username"
          />
          <div class="invalid-feedback">Please enter a username!</div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label fw-bold">Email</label>
          <input
            class="form-control rounded-pill px-3 py-2 border-secondary-subtle shadow-sm"
            type="email"
            name="email"
            required
            id="email"
            placeholder="Enter your email"
          />
          <div class="invalid-feedback">Please enter a valid email!</div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label fw-bold">Password</label>
          <input
            class="form-control rounded-pill px-3 py-2 border-secondary-subtle shadow-sm"
            type="password"
            name="password"
            required
            id="password"
            placeholder="Choose a strong password"
          />
          <div class="invalid-feedback">Please enter a password!</div>
        </div>

        <button class="btn btn-dark w-100 py-2 rounded-pill fw-bold mb-3 shadow-sm">Sign Up</button>
      </form>

      <div class="text-center my-3 text-muted small position-relative">
        <hr>
        <span class="bg-white px-3 position-absolute top-50 start-50 translate-middle">OR</span>
      </div>

      <a href="/auth/google" class="google-login-btn rounded-pill border-secondary-subtle shadow-sm">
        <img
          src="https://developers.google.com/identity/images/g-logo.png"
          alt="Google logo"
        />
        <span>Continue with Google</span>
      </a>

      <p class="text-center mt-4 mb-0 text-secondary">
        Already have an account? <a href="/login" class="text-primary fw-bold text-decoration-none">Login</a>
      </p>
    </div>
  </div>
</div>
